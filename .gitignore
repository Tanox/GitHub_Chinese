/.trae/*
!/.trae/skills/
/.vscode
/node_modules
# /build  <- 允许追踪源码
# /test   <- 允许追踪调试脚本
/utils/api
/dist
# Next.js / TypeScript 构建产物（勿提交）
/.next
# TypeScript 增量缓存统一落在 .tmp/（见 tsconfig.json 的 tsBuildInfoFile）
*.code-workspace
*.bak
github_string_fetcher.js
*/test-*
*/fix-*
*/fix_*

# 保留重要配置文件
# .eslintrc.js - 代码规范配置
# .gitattributes - Git属性配置
# package.json - 项目配置
# package-lock.json - 依赖锁定

# 测试文件不忽略，确保测试代码被版本控制
# /test

/docs/_backup
/docs/_templates
/docs/_fragments

# 仅保留 npm 单一锁文件，避免 bun/pnpm 锁漂移
bun.lock

# 运行/调试瞬时产物（采集工具与 Playwright CLI 检查生成，勿提交）
.playwright-cli/
devserver.log
collect-page.png
docs/untranslated-terms.txt
docs/har-imported-terms.txt
*.sync-conflict-*

# CI / 本地验证瞬时日志（勿提交）
build-web.log
integ.log
release-notes.md
.tmp-*
# 运行/调试瞬时产物（补充，勿提交）
*-out.txt
.*.log
.*.txt

# 统一临时目录（规范见 docs/coding-style.md §19）
# 所有日志 / 缓存 / 中间产物 / 测试输出 / 下载文件一律写入 .tmp/，自动创建、可一键清理
.tmp/

# 说明：以上 *.log / *.txt / .tmp-* 等为历史规则，仅为兼容旧工作流保留；
# 新增瞬时产物不得再写入根目录，一律使用 .tmp/。
