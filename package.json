{
  "name": "github-chinese",
  "version": "1.9.42",
  "description": "GitHub Chinese 简体中文 - GitHub 中文本地化解决方案",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:prototype": "node server.js",
    "build": "node build.cjs",
    "build:web": "next build",
    "start": "next start",
    "lint": "eslint src/ scripts/ tests/ build.cjs collect-dict.cjs server.js",
    "lint:fix": "eslint src/ scripts/ tests/ build.cjs collect-dict.cjs server.js --fix",
    "lint:length": "node scripts/check-file-length.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\" \"scripts/**/*.cjs\" \"tests/**/*.{js,cjs,mjs}\" \"build.cjs\" \"collect-dict.cjs\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx}\" \"scripts/**/*.cjs\" \"tests/**/*.{js,cjs,mjs}\" \"build.cjs\" \"collect-dict.cjs\"",
    "validate": "node scripts/validate-bundle.cjs",
    "test:unit": "node --test",
    "test": "npm run lint && npm run lint:length && npm run build && npm run test:unit && npm run validate",
    "clean": "node -e \"const fs=require('fs');['build','dist','coverage','.next'].forEach(dir=>{if(fs.existsSync(dir)){fs.rmSync(dir,{recursive:true});console.log('已清理:',dir)}})\"",
    "dict:collect": "node collect-dict.cjs",
    "prepare": "husky"
  },
  "keywords": [
    "github",
    "i18n",
    "translation",
    "chinese",
    "localization",
    "userscript",
    "tampermonkey"
  ],
  "author": "Sut",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tanox/GitHub_i18n.git"
  },
  "bugs": {
    "url": "https://github.com/Tanox/GitHub_i18n/issues"
  },
  "homepage": "https://github.com/Tanox/GitHub_i18n#readme",
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^15.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.2.0",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "next": "^16.3.5",
    "puppeteer-core": "^25.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  }
}
